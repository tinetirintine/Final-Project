<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".AddNoteActivity">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back (Cancel) -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Back"/>

        <!-- Title -->
        <EditText
            android:id="@+id/editTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Title"
            android:background="@android:color/transparent"
            android:textSize="18sp"
            android:gravity="center"
            android:inputType="textPersonName" />

        <!-- Undo -->
        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Undo"/>

        <!-- Redo -->
        <ImageButton
            android:id="@+id/btnRedo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:rotationY="180"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Redo"/>

        <!-- Search -->
        <ImageButton
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="Search"/>

        <!-- Done (Save) -->
        <ImageButton
            android:id="@+id/btnDone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/checkbox_on_background"
            android:contentDescription="Done"/>

    </LinearLayout>

    <!-- Category and Date/Time Selection -->
    <LinearLayout
        android:id="@+id/layoutOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:id="@+id/layoutDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnPickDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select Date"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnPickTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select Time"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>
    </LinearLayout>

    <!-- Note Area -->
    <EditText
        android:id="@+id/editTextNote"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:gravity="top|start"
        android:hint="Write here..."
        android:padding="16dp"
        android:textSize="18sp"
        android:inputType="textMultiLine"
        app:layout_constraintTop_toBottomOf="@id/layoutOptions"
        app:layout_constraintBottom_toTopOf="@id/bottomTools"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Bottom Toolbar -->
    <HorizontalScrollView
        android:id="@+id/bottomTools"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="#EEEEEE"
        android:scrollbars="none"
        android:fillViewport="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp">

            <Button
                android:id="@+id/btnCaps"
                android:layout_width="90dp"
                android:layout_height="50dp"
                android:text="Aa"
                android:textAllCaps="false"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btnBold"
                android:layout_width="90dp"
                android:layout_height="50dp"
                android:text="Bold"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btnItalic"
                android:layout_width="90dp"
                android:layout_height="50dp"
                android:text="Italic"
                android:textStyle="italic"
                android:textAllCaps="false"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btnUnderline"
                android:layout_width="110dp"
                android:layout_height="50dp"
                android:text="Underline"
                android:textAllCaps="false"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btnBullet"
                android:layout_width="90dp"
                android:layout_height="50dp"
                android:text="Bullet"
                android:textAllCaps="false"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btnNumber"
                android:layout_width="100dp"
                android:layout_height="50dp"
                android:text="1.2.3"
                android:textAllCaps="false"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btnAlphabet"
                android:layout_width="100dp"
                android:layout_height="50dp"
                android:text="a.b.c"
                android:textAllCaps="false"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btnAlignLeft"
                android:layout_width="110dp"
                android:layout_height="50dp"
                android:text="Left"
                android:textAllCaps="false"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btnAlignCenter"
                android:layout_width="110dp"
                android:layout_height="50dp"
                android:text="Center"
                android:textAllCaps="false"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btnAlignRight"
                android:layout_width="110dp"
                android:layout_height="50dp"
                android:text="Right"
                android:textAllCaps="false"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btnChecklist"
                android:layout_width="120dp"
                android:layout_height="50dp"
                android:text="Checklist"
                android:textAllCaps="false"/>

        </LinearLayout>

    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>