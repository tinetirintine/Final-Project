<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="final_project_db"/>
        <include domain="database" path="final_project_db-shm"/>
        <include domain="database" path="final_project_db-wal"/>
        <include domain="sharedpref" path="."/>
        <!-- Exclude security-sensitive data from cloud sync -->
        <exclude domain="sharedpref" path="DeviceTrust.xml"/>
        <exclude domain="sharedpref" path="LoginPrefs.xml"/>
        <exclude domain="sharedpref" path="BioPrefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="final_project_db"/>
        <include domain="database" path="final_project_db-shm"/>
        <include domain="database" path="final_project_db-wal"/>
        <include domain="sharedpref" path="."/>
        <!-- Exclude security-sensitive data from direct device-to-device transfer -->
        <exclude domain="sharedpref" path="DeviceTrust.xml"/>
        <exclude domain="sharedpref" path="LoginPrefs.xml"/>
        <exclude domain="sharedpref" path="BioPrefs.xml"/>
    </device-transfer>
</data-extraction-rules>